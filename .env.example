DATABASE_URL="postgresql://postgres:postgres@localhost:5434/sdi_command_center?schema=public"
NEXT_PUBLIC_APP_NAME="SDI Command Center"

# Optional: enables live AI responses. Without this, SDI One uses deterministic local intelligence.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AI_LIVE_MODE="hybrid"

# Sage Intacct v1.1 connector credentials (optional until production API sync)
INTACCT_API_ENDPOINT="https://api.intacct.com/ia/xml/xmlgw.phtml"
INTACCT_COMPANY_ID=""
INTACCT_USER_ID=""
INTACCT_USER_PASSWORD=""
INTACCT_SENDER_ID=""
INTACCT_SENDER_PASSWORD=""
INTACCT_LOCATION_ID=""
INTACCT_SESSION_TIMEOUT_MINUTES="20"

# Salesforce v1.2 connector credentials (OAuth 2.0 client credentials / refresh token ready)
SALESFORCE_LOGIN_URL="https://login.salesforce.com"
SALESFORCE_INSTANCE_URL=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_USERNAME=""
SALESFORCE_PASSWORD=""
SALESFORCE_SECURITY_TOKEN=""
SALESFORCE_API_VERSION="64.0"
SALESFORCE_ORG_ID=""

# Point of Rental connector (v1.3)
POR_MODE="csv-drop-folder"
POR_IMPORT_FOLDER="C:\POR\imports"
POR_EXPORT_FOLDER="C:\POR\exports"
POR_ODBC_DSN=""
POR_API_BASE_URL=""
POR_API_KEY=""
